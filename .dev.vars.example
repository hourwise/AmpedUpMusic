# Amped Up Music Promotions — local development variables (EXAMPLE ONLY).
#
# Copy to `.dev.vars` (git-ignored) for local Wrangler development.
# NEVER commit real values. NEVER paste production SumUp, Resend, Turnstile or
# Cloudflare credentials into this repository or into an AI agent session.
#
# Nothing below is consumed during AMPED-01 — the scaffold runs entirely on
# in-memory fixtures. These keys document the shape expected by later slices.

AMPED_ENV=development

# AMPED-07A/B — SumUp Hosted Checkout (server-side only, never exposed to client)
# Use a SANDBOX merchant's API key. Sandbox is a separate merchant account with
# its own merchant code; a live key will reject SumUp's test cards.
SUMUP_API_KEY=replace-with-development-sumup-api-key
SUMUP_MERCHANT_CODE=replace-with-development-merchant-code

# AMPED-07C1 — public HTTPS callback SumUp posts checkout status changes to.
# Sent as the API's `return_url` (the BACKEND callback); the customer's browser
# destination is `redirect_url` and is derived per-request from the server.
# NOT a secret. Leave BLANK for local development: SumUp cannot reach
# 127.0.0.1, and an unset value omits `return_url` rather than registering a
# callback that cannot work.
SUMUP_WEBHOOK_URL=

# AMPED-08C — transactional email transport (behind the provider-independent
# email contract).
#
# `console` (or blank, or `none`) selects NO external transport: the durable
# outbox records deliveries and sends nothing. `resend` selects the Resend
# adapter and REQUIRES RESEND_API_KEY and EMAIL_FROM below; a requested but
# incomplete configuration fails closed — it never falls back to a console or
# mock transport, and deliveries simply wait.
#
# Selecting `resend` does NOT verify the sender domain. DNS/SPF/DKIM
# verification must be completed in Resend before real sends can succeed;
# selecting the provider is not evidence that verification is done.
#
# Never commit a real key. Set it as a Worker secret:
#   npx wrangler secret put RESEND_API_KEY --env staging
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Amped Up Music Promotions <tickets@ampedupmusicpromo.co.uk>"
# Optional Reply-To. Blank or absent omits the header entirely.
EMAIL_REPLY_TO=

# AMPED-10A — Cloudflare Turnstile (site key is public, secret key is not)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AMPED-08B — QR admission credential signing key (rotate-able)
TICKET_TOKEN_SECRET=
