{
  "name": "ampedup",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Amped Up Music Promotions — gig promotion, ticketing and door management",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "start": "astro dev",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "db:migrate": "node src/db/cli.ts migrate",
    "db:seed": "node src/db/cli.ts seed",
    "db:reset": "node src/db/cli.ts reset"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
