---
/**
 * Curated social posts.
 *
 * V1 has no crawler: an operator pastes a URL, picks a network and optionally
 * adds a caption and thumbnail. That is a deliberate trade - a manual strip
 * that always works beats an automated one that breaks whenever a platform
 * changes its API, and the operator keeps editorial control of the homepage.
 */
import type { SocialPostView } from '@/types/view.ts';

interface Props {
  posts: SocialPostView[];
}

const { posts } = Astro.props;
---

<ul class="strip">
  {
    posts.map((item) => (
      <li class="strip-item">
        <a class="strip-link" href={item.post.url} rel="noopener">
          <span class="strip-media">
            {item.thumbnailUrl ? (
              <img src={item.thumbnailUrl} alt={item.thumbnailAlt ?? ''} loading="lazy" decoding="async" />
            ) : (
              <span class="strip-media-empty" aria-hidden="true"></span>
            )}
            <span class="strip-network">{item.networkLabel}</span>
          </span>
          {item.post.caption && <span class="strip-caption">{item.post.caption}</span>}
          {item.eventTitle && <span class="strip-event">{item.eventTitle}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .strip {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }

  .strip-link {
    display: grid;
    gap: var(--s-3);
    text-decoration: none;
  }

  .strip-media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--r);
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--ink-inset);
  }

  .strip-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--slow) var(--ease-out);
  }

  .strip-link:hover .strip-media img {
    transform: scale(1.04);
  }

  .strip-media-empty {
    display: block;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      135deg,
      rgb(255 255 255 / 4%) 0 8px,
      transparent 8px 16px
    );
  }

  .strip-network {
    position: absolute;
    left: var(--s-2);
    bottom: var(--s-2);
    padding: 0.2em 0.6em;
    border-radius: var(--r-pill);
    background: rgb(8 8 11 / 85%);
    border: 1px solid var(--hairline-strong);
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--volt);
  }

  .strip-caption {
    font-size: var(--step--1);
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .strip-link:hover .strip-caption {
    color: var(--text);
  }

  .strip-event {
    font-family: var(--font-display);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
</style>
