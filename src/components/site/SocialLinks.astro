---
/**
 * A row of social links, rendered in a consistent order wherever it appears.
 *
 * Labels are words, not icons alone: a bare glyph row is both an accessibility
 * problem and a guessing game when a network changes its mark.
 */
import { SOCIAL_LABEL, SOCIAL_ORDER } from '@/lib/text.ts';
import type { SocialLinks } from '@/types/domain.ts';

interface Props {
  links: SocialLinks;
  /** Context for the accessible label, e.g. "The Glass Hearts". */
  subject?: string;
  size?: 'sm' | 'md';
  class?: string;
}

const { links, subject, size = 'md', class: className = '' } = Astro.props;
const present = SOCIAL_ORDER.filter((network) => Boolean(links[network]));
---

{
  present.length > 0 && (
    <ul class:list={['social', `social-${size}`, className]}>
      {present.map((network) => (
        <li>
          <a href={links[network]} rel="noopener">
            {SOCIAL_LABEL[network]}
            {subject && <span class="visually-hidden"> for {subject}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .social a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }

  .social a:hover {
    color: var(--volt);
    border-color: var(--volt);
  }

  .social-sm a {
    min-height: 2.25rem;
    padding: var(--s-1) var(--s-3);
    font-size: 0.66rem;
  }
</style>
