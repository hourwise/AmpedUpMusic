---
/**
 * A prominent notice block.
 *
 * Used for cancellation and postponement messages on event pages, for the
 * "this is a scaffold" banners, and for error states. The tone is carried by
 * a word in the label as well as the colour.
 */
interface Props {
  tone?: 'info' | 'warn' | 'stop' | 'volt';
  /** Short label shown in the corner, e.g. "Cancelled". */
  label?: string;
  title?: string;
  /** Announces itself to assistive technology when it appears. */
  live?: boolean;
  class?: string;
}

const { tone = 'info', label, title, live = false, class: className = '' } = Astro.props;
---

<div
  class:list={['callout', `callout-${tone}`, className]}
  role={live ? 'status' : undefined}
  aria-live={live ? 'polite' : undefined}
>
  {label && <p class="callout-label">{label}</p>}
  {title && <p class="callout-title">{title}</p>}
  <div class="callout-body"><slot /></div>
</div>

<style>
  .callout {
    --callout-accent: var(--stage-cyan);

    display: grid;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-5);
    border: 1px solid color-mix(in srgb, var(--callout-accent) 38%, transparent);
    border-left-width: 4px;
    border-radius: var(--r);
    background: color-mix(in srgb, var(--callout-accent) 8%, transparent);
  }

  .callout-warn {
    --callout-accent: var(--warn);
  }

  .callout-stop {
    --callout-accent: var(--stop);
  }

  .callout-volt {
    --callout-accent: var(--volt);
  }

  .callout-label {
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-weight: 800;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--callout-accent);
  }

  .callout-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .callout-body {
    color: var(--text-muted);
    font-size: var(--step--1);
    max-width: 62ch;
  }

  .callout-body :global(a) {
    color: var(--callout-accent);
  }

  .callout-body :global(p + p) {
    margin-top: var(--s-3);
  }
</style>
