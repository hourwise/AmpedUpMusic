---
/**
 * Create / Edit Promotion.
 *
 * This is the screen the whole handover rests on. If Anya cannot put a gig on
 * sale from here without help, the project has failed regardless of how good
 * everything else is.
 *
 * Design decisions:
 *
 *  - Four steps, named after things a promoter says out loud: Gig, Line-up,
 *    Tickets, Artwork. Not "Entity", "Relations", "Pricing", "Assets".
 *  - The steps are tabs, not pages. Nothing is submitted between them, so
 *    there is no way to lose half a gig by closing the tab on step 3, and you
 *    can jump back to fix the date without walking backwards through a wizard.
 *  - Save Draft is available from every step, always, and is the least scary
 *    button on the screen. Publish is the loud one and asks for confirmation,
 *    because publishing is the irreversible-feeling action.
 *  - Money is entered in pounds and pence with a fixed GBP prefix. The field
 *    is converted to integer pence on submit (see src/lib/money.ts). An
 *    operator should never have to think about pence.
 *  - Every field that affects the public page says what it affects.
 *
 * AMPED-01 renders this with no submit handler. AMPED-04B wires it up.
 */
import Field from '@/components/ui/Field.astro';
import Button from '@/components/ui/Button.astro';
import AdminIcon from '@/components/admin/AdminIcon.astro';
import ScaffoldNote from '@/components/ui/ScaffoldNote.astro';
import ConfirmDialog from '@/components/ui/ConfirmDialog.astro';
import PosterImage from '@/components/events/PosterImage.astro';
import { formatPence } from '@/lib/money.ts';
import type { Artist, Venue } from '@/types/domain.ts';
import type { EventView } from '@/types/view.ts';

interface Props {
  /** Absent when creating. */
  event?: EventView;
  venues: Venue[];
  artists: Artist[];
}

const { event, venues, artists } = Astro.props;
const isEdit = Boolean(event);

/** `datetime-local` wants a local wall-clock string, not a UTC instant. */
function localInput(iso: string | undefined): string {
  if (!iso) return '';
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Europe/London',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(new Date(iso));
  const get = (t: Intl.DateTimeFormatPartTypes) => parts.find((p) => p.type === t)?.value ?? '';
  const hour = get('hour') === '24' ? '00' : get('hour');
  return `${get('year')}-${get('month')}-${get('day')}T${hour}:${get('minute')}`;
}

const STEPS = [
  { id: 'gig', label: 'Gig', hint: 'Title, date, venue' },
  { id: 'lineup', label: 'Line-up', hint: 'Who is playing' },
  { id: 'tickets', label: 'Tickets', hint: 'Prices and how many' },
  { id: 'artwork', label: 'Artwork', hint: 'Poster and socials' },
];

const AGE_OPTIONS = [
  { value: 'all-ages', label: 'All ages welcome' },
  { value: '14-plus', label: '14+ (under 16s with an adult)' },
  { value: '16-plus', label: '16+' },
  { value: '18-plus', label: '18+ (photo ID required)' },
];

const VENUE_OPTIONS = [
  { value: '', label: 'Choose a venue...' },
  ...venues.map((venue) => ({ value: venue.id, label: `${venue.name}, ${venue.city}` })),
];

/** Ticket types shown on the Tickets step. A new gig starts with one row. */
const ticketRows = event?.ticketTypes.length
  ? event.ticketTypes
  : [
      {
        id: 'new-1',
        name: 'General Admission',
        description: '',
        priceInPence: 1000,
        priceLabel: '',
        maxPerOrder: 6,
        inventory: { ticketTypeId: 'new-1', capacity: 100, sold: 0, reserved: 0, available: 100 },
        availability: 'available' as const,
        purchasable: true,
      },
    ];
---

<form class="promo" data-mock="AMPED-04B gig create and edit">
  <!-- Step navigation ---------------------------------------------------- -->
  <div class="steps" role="tablist" aria-label="Promotion steps">
    {
      STEPS.map((step, index) => (
        <button
          type="button"
          role="tab"
          class="step"
          id={`tab-${step.id}`}
          aria-controls={`panel-${step.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-step-tab={step.id}
        >
          <span class="step-number">{index + 1}</span>
          <span class="step-text">
            <span class="step-label">{step.label}</span>
            <span class="step-hint">{step.hint}</span>
          </span>
        </button>
      ))
    }
  </div>

  <!-- Step 1: Gig --------------------------------------------------------- -->
  <section
    class="panel"
    role="tabpanel"
    id="panel-gig"
    aria-labelledby="tab-gig"
    data-step-panel="gig"
  >
    <h2 class="panel-title display display-sm">The gig</h2>
    <p class="panel-intro">
      This is what people see first. The title is usually just the headline act.
    </p>

    <div class="fields">
      <Field
        name="title"
        label="Gig title"
        required
        value={event?.title}
        hint="Normally the headline band. This becomes the big heading on the gig page."
      />

      <Field
        name="strapline"
        label="Strapline"
        value={event?.strapline ?? 'Amped Up presents'}
        hint="The small line above the title."
      />

      <Field
        as="select"
        name="venueId"
        label="Venue"
        required
        value={event?.venue.id}
        options={VENUE_OPTIONS}
        hint="Not listed? Add it in Venues first - then it is there for every future gig."
      />

      <div class="field-grid">
        <Field
          name="doorsAt"
          label="Doors open"
          type="datetime-local"
          required
          value={localInput(event?.doorsAt)}
        />
        <Field
          name="startsAt"
          label="First act on stage"
          type="datetime-local"
          required
          value={localInput(event?.startsAt)}
        />
        <Field
          name="endsAt"
          label="Curfew"
          type="datetime-local"
          value={localInput(event?.endsAt)}
          hint="Used to move the gig into Past Gigs afterwards."
        />
      </div>

      <Field
        as="select"
        name="ageRestriction"
        label="Age restriction"
        required
        value={event?.ageRestriction ?? '16-plus'}
        options={AGE_OPTIONS}
      />

      <Field
        name="description"
        label="About the gig"
        as="textarea"
        rows={8}
        required
        value={event?.description}
        hint="Write it how you would say it. Leave a blank line between paragraphs."
      />

      <Field
        name="accessibilityNotes"
        label="Access notes for this night"
        as="textarea"
        rows={3}
        value={event?.accessibilityNotes}
        hint="Only things that are special to this gig. The venue's standing access information is added automatically."
      />

      <Field
        name="internalNotes"
        label="Private notes"
        as="textarea"
        rows={3}
        value={event?.internalNotes}
        hint="Only the two of you can see this. Never shown on the website."
      />
    </div>

    <div class="panel-foot">
      <Button variant="solid" size="md" data-step-next="lineup">Next: Line-up</Button>
    </div>
  </section>

  <!-- Step 2: Line-up ----------------------------------------------------- -->
  <section
    class="panel"
    role="tabpanel"
    id="panel-lineup"
    aria-labelledby="tab-lineup"
    data-step-panel="lineup"
    hidden
  >
    <h2 class="panel-title display display-sm">Who is playing</h2>
    <p class="panel-intro">
      Top of the list is the headline act. Use the arrows to change the running order.
    </p>

    <ol class="lineup-edit" data-lineup>
      {
        (event?.lineup ?? []).map((entry, index) => (
          <li class="lineup-row">
            <span class="lineup-pos">{index === 0 ? 'Headline' : index === 1 ? 'Support' : 'Also on'}</span>
            <span class="lineup-artist">{entry.artist.name}</span>
            <span class="lineup-controls">
              <button type="button" class="icon-btn" aria-label={`Move ${entry.artist.name} up`}>
                <span aria-hidden="true">^</span>
              </button>
              <button type="button" class="icon-btn" aria-label={`Move ${entry.artist.name} down`}>
                <span aria-hidden="true">v</span>
              </button>
              <button type="button" class="icon-btn icon-btn-danger" aria-label={`Remove ${entry.artist.name}`}>
                <AdminIcon name="close" size={16} />
              </button>
            </span>
          </li>
        ))
      }
      {
        (event?.lineup.length ?? 0) === 0 && (
          <li class="lineup-empty">Nobody added yet. Pick an act below.</li>
        )
      }
    </ol>

    <div class="add-artist surface-inset">
      <h3 class="add-artist-title">Add an act</h3>
      <div class="add-artist-row">
        <Field
          as="select"
          name="artistId"
          label="Choose from your artists"
          options={[
            { value: '', label: 'Choose an act...' },
            ...artists.map((artist) => ({ value: artist.id, label: artist.name })),
          ]}
        />
        <Button variant="solid" size="md">Add to the bill</Button>
      </div>
      <p class="add-artist-or">or</p>
      <Button href="/admin/artists" variant="outline" size="md">
        <AdminIcon name="plus" size={16} />
        Add a new artist
      </Button>
      <p class="add-artist-note">
        Adding an act here saves it to your artist directory, so next time you only have to pick it
        from the list.
      </p>
    </div>

    <div class="panel-foot">
      <Button variant="ghost" size="md" data-step-next="gig">Back</Button>
      <Button variant="solid" size="md" data-step-next="tickets">Next: Tickets</Button>
    </div>
  </section>

  <!-- Step 3: Tickets ----------------------------------------------------- -->
  <section
    class="panel"
    role="tabpanel"
    id="panel-tickets"
    aria-labelledby="tab-tickets"
    data-step-panel="tickets"
    hidden
  >
    <h2 class="panel-title display display-sm">Tickets</h2>
    <p class="panel-intro">
      Add one row for each kind of ticket. Leave the sale dates empty and they go on sale as soon as
      you publish.
    </p>

    <div class="ticket-rows" data-ticket-rows>
      {
        ticketRows.map((ticket, index) => (
          <fieldset class="ticket-row surface-inset">
            <legend class="ticket-legend">Ticket type {index + 1}</legend>

            <div class="ticket-grid">
              <Field
                name={`ticket-${index}-name`}
                label="Name"
                required
                value={ticket.name}
                hint="Early Bird, General Admission, Seated balcony..."
              />
              <Field
                name={`ticket-${index}-price`}
                label="Price"
                type="text"
                inputmode="decimal"
                required
                prefix="GBP"
                value={(ticket.priceInPence / 100).toFixed(2)}
                hint="No booking fee is added. This is what the customer pays."
              />
              <Field
                name={`ticket-${index}-capacity`}
                label="How many"
                type="number"
                min={0}
                required
                value={ticket.inventory.capacity}
                hint={
                  ticket.inventory.sold > 0
                    ? `${ticket.inventory.sold} already sold - you can raise this but not below what has sold.`
                    : 'Your allocation for this ticket type.'
                }
              />
              <Field
                name={`ticket-${index}-max`}
                label="Max per order"
                type="number"
                min={1}
                value={ticket.maxPerOrder}
              />
              <Field
                name={`ticket-${index}-opens`}
                label="Goes on sale"
                type="datetime-local"
                value={localInput(ticket.salesOpenAt)}
              />
              <Field
                name={`ticket-${index}-closes`}
                label="Sales close"
                type="datetime-local"
                value={localInput(ticket.salesCloseAt)}
                hint="Usually the day before, so you can sell the rest on the door."
              />
            </div>

            <Field
              name={`ticket-${index}-description`}
              label="Description"
              value={ticket.description}
              hint="One short line shown under the ticket name."
            />

            {ticket.inventory.sold > 0 && (
              <p class="ticket-sold-note">
                {ticket.inventory.sold} sold, {ticket.inventory.available} left
                {ticket.inventory.reserved > 0 && `, ${ticket.inventory.reserved} being paid for now`}.
                Worth {formatPence(ticket.inventory.sold * ticket.priceInPence)}.
              </p>
            )}

            <div class="ticket-row-actions">
              <Button variant="danger" size="sm" inert={ticket.inventory.sold > 0}>
                {ticket.inventory.sold > 0 ? 'Cannot remove - tickets sold' : 'Remove this type'}
              </Button>
            </div>
          </fieldset>
        ))
      }
    </div>

    <Button variant="outline" size="md" data-add-ticket>
      <AdminIcon name="plus" size={16} />
      Add another ticket type
    </Button>

    <div class="guest-note surface-inset">
      <h3 class="add-artist-title">Guest list</h3>
      <p>
        Guest list places are a hidden ticket type with a price of zero. They do not appear on the
        website and they do not count towards what is on sale, but they do appear in Door Mode.
      </p>
      <Field name="guestList" label="Guest list places" type="number" min={0} value={10} />
    </div>

    <div class="panel-foot">
      <Button variant="ghost" size="md" data-step-next="lineup">Back</Button>
      <Button variant="solid" size="md" data-step-next="artwork">Next: Artwork</Button>
    </div>
  </section>

  <!-- Step 4: Artwork ----------------------------------------------------- -->
  <section
    class="panel"
    role="tabpanel"
    id="panel-artwork"
    aria-labelledby="tab-artwork"
    data-step-panel="artwork"
    hidden
  >
    <h2 class="panel-title display display-sm">Artwork and socials</h2>
    <p class="panel-intro">
      The poster is the tall image people see on the listing. The hero is the wide photograph across
      the top of the gig page.
    </p>

    <div class="artwork-grid">
      <div class="upload">
        <p class="upload-label">Poster</p>
        <PosterImage src={event?.posterUrl} alt={event?.posterAlt} title={event?.title ?? 'New gig'} />
        <div class="upload-drop">
          <p>Drop an image here, or</p>
          <Button variant="outline" size="sm">Choose a file</Button>
          <p class="upload-hint">Tall image, roughly 3 wide by 4 tall. JPG or PNG, up to 8&nbsp;MB.</p>
        </div>
        <Field
          name="posterAlt"
          label="Describe this image"
          required
          value={event?.posterAlt}
          hint="For people using a screen reader, and for search engines. One plain sentence."
        />
      </div>

      <div class="upload">
        <p class="upload-label">Hero photograph</p>
        <PosterImage
          src={event?.heroUrl}
          alt={event?.heroAlt}
          title={event?.title ?? 'New gig'}
          ratio="wide"
        />
        <div class="upload-drop">
          <p>Drop an image here, or</p>
          <Button variant="outline" size="sm">Choose a file</Button>
          <p class="upload-hint">Wide image, roughly 16 by 9. A crowd shot works best.</p>
        </div>
        <Field name="heroAlt" label="Describe this image" value={event?.heroAlt} />
      </div>
    </div>

    <ScaffoldNote slice="AMPED-05A">
      Uploads are not connected. In V1 the file goes to Cloudflare R2 with a safe unique name, a
      size and type check, and the alt text is stored with it. Alt text is required before a gig can
      be published.
    </ScaffoldNote>

    <fieldset class="socials surface-inset">
      <legend class="ticket-legend">Links for this gig</legend>
      <div class="field-grid">
        <Field name="instagram" label="Instagram post" type="url" value={event?.links.instagram} />
        <Field name="tiktok" label="TikTok" type="url" value={event?.links.tiktok} />
        <Field name="facebook" label="Facebook event" type="url" value={event?.links.facebook} />
        <Field name="youtube" label="YouTube" type="url" value={event?.links.youtube} />
      </div>
    </fieldset>

    <fieldset class="socials surface-inset">
      <legend class="ticket-legend">Photography</legend>
      <div class="field-grid">
        <Field
          name="photographyCredit"
          label="Photographer"
          value={event?.photography?.credit ?? 'AnyaParallax'}
          hint="Credited on the gig page and in the gallery."
        />
        <Field
          name="photographyGallery"
          label="Gallery link"
          type="url"
          value={event?.photography?.galleryUrl}
          hint="Add this after the gig, once the full set is up."
        />
      </div>
    </fieldset>

    <div class="panel-foot">
      <Button variant="ghost" size="md" data-step-next="tickets">Back</Button>
    </div>
  </section>

  <!-- Persistent action bar ------------------------------------------------ -->
  <div class="promo-bar">
    <div class="promo-bar-inner">
      <p class="promo-status">
        {
          isEdit ? (
            <>
              Editing <strong>{event?.title}</strong>
            </>
          ) : (
            <>New promotion - not saved yet</>
          )
        }
      </p>
      <div class="promo-bar-actions">
        <Button variant="ghost" size="md">Save draft</Button>
        <Button href={event?.href ?? '/gigs'} variant="outline" size="md">Preview</Button>
        <Button variant="volt" size="md" data-confirm-open="publish-confirm">
          {event?.status === 'published' ? 'Save changes' : 'Publish'}
        </Button>
      </div>
    </div>
  </div>
</form>

<ConfirmDialog
  id="publish-confirm"
  tone="volt"
  title={event?.status === 'published' ? 'Save these changes?' : 'Publish this gig?'}
  body={
    event?.status === 'published'
      ? 'The gig page will update straight away.'
      : 'The gig will appear on the website immediately and tickets will go on sale according to the dates you set.'
  }
  consequence={
    event?.status === 'published'
      ? undefined
      : 'Anyone with the link will be able to buy a ticket from the moment you publish.'
  }
  confirmLabel={event?.status === 'published' ? 'Save changes' : 'Publish now'}
  cancelLabel="Not yet"
/>

<script>
  // Tab switching. Roving tabindex plus arrow-key support, because this is the
  // screen an operator will use most and keyboard users should not be second
  // class on it.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-step-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-step-panel]'));

  function activate(id: string, focusTab = true) {
    tabs.forEach((tab) => {
      const selected = tab.dataset.stepTab === id;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
      if (selected && focusTab) tab.focus();
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.stepPanel !== id;
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activate(tab.dataset.stepTab ?? '', false));
    tab.addEventListener('keydown', (event) => {
      const direction = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (direction === 0) return;
      event.preventDefault();
      const next = tabs[(index + direction + tabs.length) % tabs.length];
      if (next) activate(next.dataset.stepTab ?? '');
    });
  });

  document.querySelectorAll<HTMLElement>('[data-step-next]').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      activate(button.dataset.stepNext ?? '', false);
    });
  });

  // Adding a ticket type clones the last row and renumbers it. AMPED-04B
  // replaces this with a proper form model; the interaction is the point here.
  document.querySelector('[data-add-ticket]')?.addEventListener('click', (event) => {
    event.preventDefault();
    const container = document.querySelector<HTMLElement>('[data-ticket-rows]');
    const rows = container?.querySelectorAll('.ticket-row');
    const last = rows?.[rows.length - 1];
    if (!container || !last) return;

    const clone = last.cloneNode(true) as HTMLElement;
    const index = rows.length;
    const legend = clone.querySelector('legend');
    if (legend) legend.textContent = `Ticket type ${index + 1}`;
    clone.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((input) => {
      const name = input.name.replace(/ticket-\d+-/, `ticket-${index}-`);
      input.name = name;
      input.id = name;
      if (input.type !== 'number' && input.type !== 'datetime-local') input.value = '';
    });
    clone.querySelectorAll<HTMLLabelElement>('label').forEach((label) => {
      if (label.htmlFor) label.htmlFor = label.htmlFor.replace(/ticket-\d+-/, `ticket-${index}-`);
    });
    clone.querySelector('.ticket-sold-note')?.remove();
    container.appendChild(clone);
    clone.querySelector<HTMLInputElement>('input')?.focus();
  });

  // Nothing is submitted during AMPED-01.
  document.querySelector<HTMLFormElement>('.promo')?.addEventListener('submit', (event) => {
    event.preventDefault();
  });
</script>

<style>
  .promo {
    display: grid;
    gap: var(--s-5);
    padding-bottom: 6rem;
  }

  /* --- Steps --------------------------------------------------------------- */

  .steps {
    display: grid;
    gap: var(--s-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .step {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 3.5rem;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--hairline);
    border-radius: var(--r);
    background: var(--ink-raised);
    color: var(--text-muted);
    text-align: left;
    cursor: pointer;
    transition: border-color var(--fast) var(--ease), background-color var(--fast) var(--ease);
  }

  .step:hover {
    border-color: var(--hairline-strong);
    color: var(--text);
  }

  .step[aria-selected='true'] {
    border-color: var(--volt);
    background: color-mix(in srgb, var(--volt) 10%, var(--ink-raised));
    color: var(--text);
  }

  .step-number {
    display: grid;
    place-content: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 8%);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step--1);
  }

  .step[aria-selected='true'] .step-number {
    background: var(--volt);
    color: var(--text-on-accent);
  }

  .step-text {
    display: grid;
    min-width: 0;
  }

  .step-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
  }

  .step-hint {
    font-size: 0.68rem;
    color: var(--text-faint);
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* --- Panels -------------------------------------------------------------- */

  .panel {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-5);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    background: var(--ink-raised);
  }

  .panel[hidden] {
    display: none;
  }

  .panel-intro {
    font-size: var(--step--1);
    color: var(--text-muted);
    max-width: 62ch;
    margin-top: calc(var(--s-3) * -1);
  }

  .fields {
    display: grid;
    gap: var(--s-4);
  }

  .field-grid {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 44rem) {
    .field-grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    }
  }

  .panel-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: flex-end;
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline);
  }

  /* --- Line-up ------------------------------------------------------------- */

  .lineup-edit {
    display: grid;
    gap: var(--s-2);
  }

  .lineup-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3);
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    background: var(--ink-inset);
  }

  .lineup-pos {
    font-family: var(--font-display);
