---
/**
 * The ticket panel: the commercial heart of the event page.
 *
 * Design decisions:
 *  - Each ticket type is a row with a quantity stepper and its own price, so
 *    there is no hidden "select type" step. On a phone the whole row is one
 *    tap target column with 44px controls.
 *  - Unavailable types are shown, not hidden. "Early Bird - sold out" tells a
 *    customer that they are late rather than that the price changed.
 *  - The running total and the single Checkout button are sticky at the bottom
 *    of the panel, so the commitment step is always in view while choosing.
 *
 * AMPED-07B wires the Checkout button to the real server endpoint. What the
 * browser sends is deliberately thin: ticket type ids, quantities and contact
 * details. It does NOT send a price, a total, a currency or a checkout
 * reference - the server recomputes all of that from D1, and the running total
 * below is a convenience for the customer, never an input to the charge.
 *
 * No card field exists here and none ever will: card data is entered only on
 * SumUp's own hosted page, so it never touches Amped Up HTML or JavaScript.
 */
import AvailabilityBadge from './AvailabilityBadge.astro';
import Button from '@/components/ui/Button.astro';
import Callout from '@/components/ui/Callout.astro';
import { formatShortDate, formatTime } from '@/lib/dates.ts';
import type { EventView } from '@/types/view.ts';

interface Props {
  event: EventView;
}

const { event } = Astro.props;
const isDisrupted = event.status === 'cancelled' || event.status === 'postponed';
const anyPurchasable = event.ticketTypes.some((t) => t.purchasable);
---

<section
  class="tickets surface"
  id="tickets"
  aria-labelledby="tickets-heading"
  data-event-id={event.id}
>
  <header class="tickets-head">
    <h2 class="display display-sm" id="tickets-heading">Tickets</h2>
    <AvailabilityBadge state={event.availability} long />
  </header>

  {
    isDisrupted ? (
      <div class="tickets-disrupted">
        <Callout
          tone="stop"
          label={event.status === 'cancelled' ? 'Cancelled' : 'Postponed'}
          title={
            event.status === 'cancelled'
              ? 'This show is not going ahead'
              : 'This show has moved to a new date'
          }
        >
          <p>{event.statusMessage}</p>
        </Callout>
      </div>
    ) : event.ticketTypes.length === 0 ? (
      <p class="tickets-none muted">
        Tickets for this show are not being sold online. Pay on the door, cash or card.
      </p>
    ) : (
      <>
        <ul class="tickets-list" data-ticket-list>
          {event.ticketTypes.map((ticket) => (
            <li class:list={['ticket', !ticket.purchasable && 'ticket-unavailable']}>
              <div class="ticket-main">
                <p class="ticket-name">{ticket.name}</p>
                {ticket.description && <p class="ticket-desc">{ticket.description}</p>}
                <p class="ticket-window">
                  {ticket.availability === 'not-yet-on-sale' && ticket.salesOpenAt && (
                    <span>
                      On sale {formatShortDate(ticket.salesOpenAt)} at {formatTime(ticket.salesOpenAt)}
                    </span>
                  )}
                  {ticket.availability === 'available' && ticket.salesCloseAt && (
                    <span>Online sales close {formatShortDate(ticket.salesCloseAt)}</span>
                  )}
                  {ticket.availability === 'selling-fast' && ticket.salesCloseAt && (
                    <span>Online sales close {formatShortDate(ticket.salesCloseAt)}</span>
                  )}
                </p>
              </div>

              <div class="ticket-side">
                <p class="ticket-price">{ticket.priceLabel}</p>
                <AvailabilityBadge state={ticket.availability} size="sm" />
              </div>

              <div class="ticket-controls">
                {ticket.purchasable ? (
                  <div
                    class="stepper"
                    data-stepper
                    data-ticket-type-id={ticket.id}
                    data-price={ticket.priceInPence}
                    data-max={Math.min(ticket.maxPerOrder, ticket.inventory.available)}
                  >
                    <button
                      type="button"
                      class="stepper-btn"
                      data-step="-1"
                      aria-label={`One fewer ${ticket.name} ticket`}
                    >
                      <span aria-hidden="true">-</span>
                    </button>
                    <output
                      class="stepper-value"
                      data-value
                      aria-live="polite"
                      aria-label={`${ticket.name} quantity`}
                    >0</output>
                    <button
                      type="button"
                      class="stepper-btn"
                      data-step="1"
                      aria-label={`One more ${ticket.name} ticket`}
                    >
                      <span aria-hidden="true">+</span>
                    </button>
                  </div>
                ) : (
                  <p class="ticket-closed">
                    {ticket.availability === 'sold-out' ? 'None left' : 'Not on sale'}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>

        <form class="tickets-form" data-checkout-form>
          <fieldset class="tickets-customer">
            <legend class="tickets-customer-legend">Your details</legend>

            <div class="field">
              <label for="checkout-name">Name</label>
              <input
                type="text"
                id="checkout-name"
                name="customerName"
                autocomplete="name"
                required
                minlength="2"
                maxlength="120"
                data-customer-name
              />
            </div>

            <div class="field">
              <label for="checkout-email">Email</label>
              <input
                type="email"
                id="checkout-email"
                name="customerEmail"
                autocomplete="email"
                required
                maxlength="200"
                aria-describedby="checkout-email-hint"
                data-customer-email
              />
              <p class="field-hint" id="checkout-email-hint">
                Your tickets and QR codes are sent here.
              </p>
            </div>
          </fieldset>

          <div class="tickets-foot">
            <p class="tickets-total">
              <span class="tickets-total-label">Total</span>
              <output class="tickets-total-value" data-total aria-live="polite">&pound;0.00</output>
            </p>
            <Button
              type="submit"
              variant="volt"
              size="lg"
              block
              data-checkout
              inert={!anyPurchasable}
            >
              {anyPurchasable ? 'Checkout' : 'Not on sale'}
            </Button>
          </div>

          <p class="checkout-error" data-checkout-error role="alert" hidden></p>

          <p class="checkout-secure">
            Card details are entered on SumUp's secure payment page, never on this site.
          </p>
        </form>

        <ul class="tickets-reassurance">
          <li>Tickets arrive by email with a QR code. Bring your phone or a printout.</li>
          <li>Maximum {event.ticketTypes[0]?.maxPerOrder ?? 6} tickets per order.</li>
          <li><a href="/ticket-terms">Ticket terms, refunds and cancellations</a></li>
        </ul>
      </>
    )
  }
</section>

<script>
  // Quantity steppers and the running total. Pure arithmetic in the browser;
  // the authoritative price is always recalculated server-side at checkout.
  const panel = document.querySelector<HTMLElement>('[data-ticket-list]');
  const totalOutput = document.querySelector<HTMLOutputElement>('[data-total]');
  const checkout = document.querySelector<HTMLElement>('[data-checkout]');

  const gbp = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' });

  function recalculate() {
    if (!panel || !totalOutput) return;
    let pence = 0;
    let count = 0;
    panel.querySelectorAll<HTMLElement>('[data-stepper]').forEach((stepper) => {
      const value = Number(stepper.querySelector('[data-value]')?.textContent ?? '0');
      pence += value * Number(stepper.dataset.price ?? '0');
      count += value;
    });
    totalOutput.textContent = gbp.format(pence / 100);
    if (checkout instanceof HTMLElement) {
      checkout.textContent = count > 0 ? `Checkout - ${count} ticket${count === 1 ? '' : 's'}` : 'Checkout';
    }
  }

  panel?.querySelectorAll<HTMLElement>('[data-stepper]').forEach((stepper) => {
    const output = stepper.querySelector<HTMLOutputElement>('[data-value]');
    const max = Number(stepper.dataset.max ?? '6');

    stepper.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!output) return;
        const step = Number(button.dataset.step ?? '0');
        const next = Math.min(max, Math.max(0, Number(output.textContent ?? '0') + step));
        output.textContent = String(next);
        stepper.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => {
          const s = Number(b.dataset.step ?? '0');
          b.disabled = (s < 0 && next === 0) || (s > 0 && next >= max);
        });
        recalculate();
      });
    });

    // Start with "-" disabled, since every stepper starts at zero.
    stepper.querySelector<HTMLButtonElement>('[data-step="-1"]')?.setAttribute('disabled', '');
  });

  // --- Checkout submission (AMPED-07B) ------------------------------------
  //
  // The payload carries ticket type ids, quantities and contact details and
  // nothing else. No price, total, currency or reference is sent: the server
  // recomputes the charge from D1, so tampering with anything reachable from
  // devtools changes the displayed total and not a penny of what is charged.

  const section = document.querySelector<HTMLElement>('[data-event-id]');
  const form = document.querySelector<HTMLFormElement>('[data-checkout-form]');
  const nameInput = document.querySelector<HTMLInputElement>('[data-customer-name]');
  const emailInput = document.querySelector<HTMLInputElement>('[data-customer-email]');
  const errorOutput = document.querySelector<HTMLElement>('[data-checkout-error]');

  /** True while a request is in flight, so a double click cannot send two. */
  let submitting = false;

  function showError(message: string) {
    if (!errorOutput) return;
    errorOutput.textContent = message;
    errorOutput.hidden = false;
  }

  function clearError() {
    if (!errorOutput) return;
    errorOutput.textContent = '';
    errorOutput.hidden = true;
  }

  function selectedItems(): Array<{ ticketTypeId: string; quantity: number }> {
    if (!panel) return [];
    const items: Array<{ ticketTypeId: string; quantity: number }> = [];
    panel.querySelectorAll<HTMLElement>('[data-stepper]').forEach((stepper) => {
      const quantity = Number(stepper.querySelector('[data-value]')?.textContent ?? '0');
      const ticketTypeId = stepper.dataset.ticketTypeId ?? '';
      if (quantity > 0 && ticketTypeId) items.push({ ticketTypeId, quantity });
    });
    return items;
  }

  /** Turn a controlled API failure into something worth reading. */
  function messageFor(status: number, payload: { error?: string; fields?: Record<string, string> }) {
    const firstField = payload.fields ? Object.values(payload.fields)[0] : undefined;
    if (status === 400) return firstField ?? 'Please check your details and try again.';
    if (status === 404) return firstField ?? 'Those tickets are no longer on sale.';
    if (status === 409) return firstField ?? 'Those tickets are no longer available.';
    if (status === 503) return 'Checkout is temporarily unavailable. Please try again shortly.';
    return 'Something went wrong starting checkout. Please try again.';
  }

  function setBusy(busy: boolean) {
    submitting = busy;
    if (!(checkout instanceof HTMLButtonElement)) return;
    checkout.disabled = busy;
    checkout.setAttribute('aria-busy', busy ? 'true' : 'false');
  }

  form?.addEventListener('submit', async (submitEvent) => {
    submitEvent.preventDefault();

    // The guard that matters for ordinary double clicks. It is a courtesy to
    // the customer, NOT an idempotency mechanism: the server must stay correct
    // if this request arrives twice anyway.
    if (submitting) return;

    clearError();

    const eventId = section?.dataset.eventId ?? '';
    const items = selectedItems();
    if (items.length === 0) {
      showError('Choose at least one ticket.');
      return;
    }
    if (!eventId) {
      showError('Something went wrong starting checkout. Please try again.');
      return;
    }

    setBusy(true);
    try {
      const response = await fetch('/api/checkout/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          eventId,
          items,
          customerName: nameInput?.value.trim() ?? '',
          customerEmail: emailInput?.value.trim() ?? '',
        }),
      });

      const payload = (await response.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
        fields?: Record<string, string>;
        redirectUrl?: string;
      };

      if (!response.ok || !payload.ok) {
        showError(messageFor(response.status, payload));
        setBusy(false);
        return;
      }

      // The ONLY redirect target is the hosted URL the server returned, and
      // only when it is absolute https. Nothing from this page, the query
      // string or the response is appended to it.
      let hosted: URL;
      try {
        hosted = new URL(payload.redirectUrl ?? '');
      } catch {
        showError('Something went wrong starting checkout. Please try again.');
        setBusy(false);
        return;
      }
      if (hosted.protocol !== 'https:') {
        showError('Something went wrong starting checkout. Please try again.');
        setBusy(false);
        return;
      }

      // Deliberately left busy: the tickets are now held and the browser is
      // leaving for SumUp. Re-enabling would invite a second order.
      window.location.assign(hosted.toString());
    } catch {
      showError('Could not reach the server. Check your connection and try again.');
      setBusy(false);
    }
  });
</script>

<style>
  .tickets {
    padding: var(--s-5);
    display: grid;
    gap: var(--s-4);
    scroll-margin-top: calc(var(--header-h) + var(--s-4));
  }

  .tickets-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .tickets-list {
    display: grid;
    gap: var(--s-2);
  }

  .ticket {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'main side'
      'controls controls';
    gap: var(--s-3);
    padding: var(--s-4);
    border: 1px solid var(--hairline);
    border-radius: var(--r);
    background: var(--ink-inset);
    transition: border-color var(--fast) var(--ease);
  }

  .ticket:hover {
    border-color: var(--hairline-strong);
  }

  .ticket-unavailable {
    opacity: 0.55;
  }

  .ticket-main {
    grid-area: main;
    display: grid;
    gap: 0.2em;
    align-content: start;
  }

  .ticket-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-0);
  }

  .ticket-desc {
    font-size: var(--step--2);
    color: var(--text-muted);
    max-width: 44ch;
  }

  .ticket-window {
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .ticket-window:empty {
    display: none;
  }

  .ticket-side {
    grid-area: side;
    display: grid;
    gap: var(--s-2);
    justify-items: end;
    align-content: start;
  }

  .ticket-price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--step-1);
    line-height: 1;
  }

  .ticket-controls {
    grid-area: controls;
    display: flex;
    justify-content: flex-end;
  }

  .ticket-closed {
    font-family: var(--font-display);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* --- Stepper ----------------------------------------------------------- */

  .stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-pill);
    overflow: hidden;
    background: var(--ink-raised-2);
  }

  .stepper-btn {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-content: center;
    background: transparent;
    border: 0;
    color: var(--text);
    font-size: 1.25rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--fast) var(--ease), color var(--fast) var(--ease);
  }

  .stepper-btn:hover:not(:disabled) {
    background: var(--volt);
    color: var(--text-on-accent);
  }

  .stepper-btn:disabled {
    color: var(--text-faint);
    cursor: not-allowed;
  }

  .stepper-value {
    min-width: 2.5rem;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-0);
    font-variant-numeric: tabular-nums;
  }

  /* --- Customer details (AMPED-07B) -------------------------------------- */

  .tickets-form {
    display: grid;
    gap: var(--s-4);
  }

  .tickets-customer {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4);
    border: 1px solid var(--hairline);
    border-radius: var(--r);
    background: var(--ink-inset);
  }

  .tickets-customer-legend {
    padding-inline: var(--s-2);
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .field {
    display: grid;
    gap: var(--s-2);
  }

  .field label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .field input {
    width: 100%;
    /* 44px minimum target, matching the steppers. */
    min-height: 2.75rem;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-sm);
    background: var(--ink-raised-2);
    color: var(--text);
    font: inherit;
    font-size: var(--step-0);
  }

  .field input:focus-visible {
    outline: 2px solid var(--volt);
    outline-offset: 2px;
    border-color: var(--volt);
  }

  .field input:user-invalid {
    border-color: var(--stop);
  }

  .field-hint {
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .checkout-error {
    padding: var(--s-3);
    border: 1px solid color-mix(in srgb, var(--stop) 55%, transparent);
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--stop) 12%, transparent);
    font-size: var(--step--1);
    color: var(--text);
  }

  .checkout-error[hidden] {
    display: none;
  }

  .checkout-secure {
    font-size: var(--step--2);
    color: var(--text-faint);
    text-align: center;
  }

  /* --- Foot -------------------------------------------------------------- */

  .tickets-foot {
    display: grid;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline);
  }

  .tickets-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .tickets-total-label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .tickets-total-value {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--step-2);
    font-variant-numeric: tabular-nums;
  }

  .tickets-reassurance {
    display: grid;
    gap: var(--s-2);
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .tickets-reassurance a {
    color: var(--text-muted);
  }

  .tickets-none {
    font-size: var(--step--1);
  }

  @media (min-width: 30rem) {
    .ticket {
      grid-template-columns: 1fr auto auto;
      grid-template-areas: 'main side controls';
      align-items: center;
      gap: var(--s-4);
    }

    .ticket-controls {
      justify-content: flex-start;
    }
  }
</style>
