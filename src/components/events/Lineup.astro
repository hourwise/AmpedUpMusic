---
/**
 * The bill, in running order.
 *
 * Headline first, and every act links to its artist page so the same record
 * powers the lineup, the artist directory and the "they have played for us
 * before" connection.
 */
import { formatTime } from '@/lib/dates.ts';
import type { LineupEntryView } from '@/types/view.ts';

interface Props {
  lineup: LineupEntryView[];
  /** Past events show set times as history; upcoming ones as a plan. */
  showSetTimes?: boolean;
}

const { lineup, showSetTimes = true } = Astro.props;

const BILLING_LABEL: Record<LineupEntryView['billing'], string> = {
  headline: 'Headline',
  support: 'Support',
  opener: 'Also on',
};
---

<ol class="lineup">
  {
    lineup.map((entry) => (
      <li class:list={['lineup-item', `lineup-${entry.billing}`]}>
        <a class="lineup-link" href={`/artists/${entry.artist.slug}`}>
          <span class="lineup-image">
            {entry.imageUrl ? (
              <img src={entry.imageUrl} alt="" loading="lazy" decoding="async" />
            ) : (
              <span class="lineup-image-empty" aria-hidden="true"></span>
            )}
          </span>

          <span class="lineup-text">
            <span class="lineup-billing">{BILLING_LABEL[entry.billing]}</span>
            <span class="lineup-name">{entry.artist.name}</span>
            {entry.artist.tagline && <span class="lineup-tagline">{entry.artist.tagline}</span>}
            {entry.billingNote && <span class="lineup-note">{entry.billingNote}</span>}
          </span>

          {showSetTimes && entry.setTime && (
            <span class="lineup-time">
              <span class="visually-hidden">On stage at </span>
              {formatTime(entry.setTime)}
            </span>
          )}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .lineup {
    display: grid;
    gap: var(--s-2);
    counter-reset: act;
  }

  .lineup-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-3);
    border: 1px solid var(--hairline);
    border-radius: var(--r);
    background: var(--ink-raised);
    text-decoration: none;
    transition: border-color var(--fast) var(--ease), background-color var(--fast) var(--ease);
  }

  .lineup-link:hover {
    border-color: var(--volt);
    background: var(--ink-raised-2);
  }

  .lineup-headline .lineup-link {
    border-left: 3px solid var(--volt);
  }

  .lineup-image {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--r-sm);
    overflow: hidden;
    background: var(--ink-inset);
    flex: none;
  }

  .lineup-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lineup-image-empty {
    display: block;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      135deg,
      rgb(255 255 255 / 4%) 0 6px,
      transparent 6px 12px
    );
  }

  .lineup-text {
    display: grid;
    gap: 0.12em;
    min-width: 0;
  }

  .lineup-billing {
    font-family: var(--font-display);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .lineup-headline .lineup-billing {
    color: var(--volt);
  }

  .lineup-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 84%;
    font-size: var(--step-1);
    line-height: 1.1;
  }

  .lineup-headline .lineup-name {
    font-size: var(--step-2);
    text-transform: uppercase;
  }

  .lineup-tagline,
  .lineup-note {
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  .lineup-note {
    color: var(--stage-cyan);
  }

  .lineup-time {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
