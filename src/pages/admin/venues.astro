---
/**
 * Venue directory.
 *
 * Same idea as artists: enter a room once and it is in the dropdown forever.
 *
 * Accessibility information lives on the VENUE, not on the event, because it
 * is a property of the building. Putting it here means it cannot be forgotten
 * when a gig is created in a hurry, and correcting it once fixes every event
 * page at that venue at the same time.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import Field from '@/components/ui/Field.astro';
import Button from '@/components/ui/Button.astro';
import Callout from '@/components/ui/Callout.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { getServices } from '@/services/index.ts';

const services = getServices();
const [venues, gigs] = await Promise.all([services.venues.list(), services.admin.listAll()]);

const usage = new Map<string, { total: number; upcoming: number }>();
for (const gig of gigs) {
  const entry = usage.get(gig.venue.id) ?? { total: 0, upcoming: 0 };
  entry.total += 1;
  if (!gig.isPast) entry.upcoming += 1;
  usage.set(gig.venue.id, entry);
}
---

<AdminLayout
  title="Venues"
  subtitle="The rooms you use. Access information you enter here appears automatically on every gig at that venue."
  wide
>
  <Button slot="actions" variant="volt" size="md" href="#add-venue">Add a venue</Button>

  {
    venues.length > 0 ? (
      <ul class="venue-grid">
        {venues.map((venue) => {
          const used = usage.get(venue.id);
          return (
            <li
              class="venue-item surface"
              data-venue-row
              data-venue-id={venue.id}
              data-venue-archived={venue.archivedAt ? 'true' : 'false'}
              data-venue={JSON.stringify({
                name: venue.name,
                addressLine1: venue.addressLine1,
                addressLine2: venue.addressLine2 ?? '',
                city: venue.city,
                postcode: venue.postcode,
                standardNotes: venue.standardNotes ?? '',
                accessibilityInfo: venue.accessibilityInfo ?? '',
                capacity: venue.capacity ?? '',
                websiteUrl: venue.websiteUrl ?? '',
                mapUrl: venue.mapUrl ?? '',
              })}
            >
              <div class="venue-head">
                <h2 class="display display-sm">
                  {venue.name}
                  {venue.archivedAt && <span class="venue-archived">Archived</span>}
                </h2>
                {venue.capacity && <p class="venue-cap">Holds {venue.capacity}</p>}
              </div>

              <address class="venue-address">
                {[venue.addressLine1, venue.addressLine2, venue.city, venue.postcode]
                  .filter(Boolean)
                  .join(', ')}
              </address>

              {venue.standardNotes && <p class="venue-notes">{venue.standardNotes}</p>}

              <div class="venue-access">
                <p class="eyebrow eyebrow-accent">Access</p>
                <p>{venue.accessibilityInfo ?? 'Not filled in yet.'}</p>
              </div>

              <p class="venue-usage">
                {used?.total ?? 0} {used?.total === 1 ? 'gig' : 'gigs'} here
                {used && used.upcoming > 0 && <span class="venue-upcoming">{used.upcoming} coming up</span>}
              </p>

              <div class="venue-actions">
                {venue.archivedAt ? (
                  <span class="venue-archived-note">Archived - historical only</span>
                ) : (
                  <>
                    <Button variant="ghost" size="sm" type="button" data-edit-venue>
                      Edit
                    </Button>
                    <Button variant="ghost" size="sm" type="button" data-archive-venue>
                      Archive
                    </Button>
                  </>
                )}
                <Button variant="ghost" size="sm" type="button" data-delete-venue>
                  Delete
                </Button>
                {venue.mapUrl && (
                  <Button href={venue.mapUrl} variant="ghost" size="sm" rel="noopener">
                    Map
                  </Button>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    ) : (
      <EmptyState
        title="No venues yet"
        body="Add the rooms you put gigs on in, and they will be in the dropdown when you create a promotion."
        actionHref="#add-venue"
        actionLabel="Add a venue"
      />
    )
  }

  <section class="add-panel surface" id="add-venue" aria-labelledby="add-venue-heading">
    <h2 class="display display-sm" id="add-venue-heading">Add a venue</h2>

    <Callout tone="volt" label="Worth getting right" title="Access information is not optional">
      <p>
        Whatever you write in the access box appears on every gig page at this venue. Be specific
        and be honest - "down twelve steps, no lift" is far more useful to somebody than leaving it
        blank or writing "please contact us".
      </p>
    </Callout>

    <form class="add-form" data-venue-form>
      <input type="hidden" name="venueId" data-venue-id-input />
      <div class="add-grid">
        <Field name="name" label="Venue name" required />
        <Field name="capacity" label="Capacity" type="number" min={0} />
      </div>
      <div class="add-grid">
        <Field name="addressLine1" label="Address" required />
        <Field name="addressLine2" label="Address line 2" />
      </div>
      <div class="add-grid">
        <Field name="city" label="Town or city" required />
        <Field name="postcode" label="Postcode" required />
      </div>
      <Field
        name="mapUrl"
        label="Map link"
        type="url"
        hint="Paste a link from your maps app so the pin is right."
      />
      <Field name="websiteUrl" label="Venue website" type="url" />
      <Field
        name="standardNotes"
        label="Things that are always true here"
        as="textarea"
        rows={3}
        hint="Bar times, parking, cloakroom, which door to use."
      />
      <Field
        name="accessibilityInfo"
        label="Access information"
        as="textarea"
        rows={4}
        required
        hint="Step-free or not, toilets, viewing positions, assistance dogs, hearing loop."
      />

      <div class="add-actions">
        <Button variant="ghost" size="md" type="button" class="is-hidden" data-cancel-venue>
          Cancel
        </Button>
        <Button type="submit" variant="volt" size="md" data-save-venue>Save venue</Button>
      </div>
      <p class="form-feedback" data-venue-feedback role="status" aria-live="polite" hidden></p>
    </form>
  </section>
</AdminLayout>

<script>
  // AMPED-04C: real protected CRUD for venues. Accessibility is required and
  // enforced by the server as well as the browser.
  const form = document.querySelector<HTMLFormElement>('[data-venue-form]');

  if (form) {
    const idInput = form.querySelector<HTMLInputElement>('[data-venue-id-input]');
    const heading = document.querySelector('#add-venue-heading');
    const saveLabel = form.querySelector<HTMLElement>('[data-save-venue]');
    const cancel = form.querySelector<HTMLElement>('[data-cancel-venue]');
    const feedback = document.querySelector<HTMLElement>('[data-venue-feedback]');

    const say = (message: string, tone: 'ok' | 'error') => {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.dataset.tone = tone;
      feedback.hidden = false;
    };

    const field = (name: string) =>
      (
        form.querySelector(`[name="${name}"]`) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | null
      )?.value.trim() ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const id = idInput?.value ?? '';
      const payload = {
        name: field('name'),
        addressLine1: field('addressLine1'),
        addressLine2: field('addressLine2'),
        city: field('city'),
        postcode: field('postcode'),
        standardNotes: field('standardNotes'),
        accessibilityInfo: field('accessibilityInfo'),
        capacity: field('capacity'),
        websiteUrl: field('websiteUrl'),
        mapUrl: field('mapUrl'),
      };

      try {
        const response = await fetch(
          id ? `/api/admin/venues/${encodeURIComponent(id)}` : '/api/admin/venues',
          {
            method: id ? 'PATCH' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          },
        );
        const data = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          fields?: Record<string, string>;
        };
        if (!response.ok || !data.ok) {
          throw new Error(
            data.fields
              ? Object.values(data.fields).filter(Boolean).join(' ')
              : 'That venue could not be saved.',
          );
        }
        window.location.reload();
      } catch (error) {
        say(error instanceof Error ? error.message : 'Could not save.', 'error');
      }
    });

    document.querySelectorAll<HTMLElement>('[data-venue-row]').forEach((row) => {
      const id = row.dataset.venueId ?? '';
      const name = (JSON.parse(row.dataset.venue ?? '{}') as { name?: string }).name ?? '';

      row.querySelector('[data-edit-venue]')?.addEventListener('click', () => {
        const data = JSON.parse(row.dataset.venue ?? '{}') as Record<string, string>;
        if (idInput) idInput.value = id;
        for (const key of [
          'name',
          'addressLine1',
          'addressLine2',
          'city',
          'postcode',
          'standardNotes',
          'accessibilityInfo',
          'capacity',
          'websiteUrl',
          'mapUrl',
        ]) {
          const input = form.querySelector(`[name="${key}"]`) as
            | HTMLInputElement
            | HTMLTextAreaElement
            | null;
          if (input) input.value = data[key] ?? '';
        }
        if (heading) heading.textContent = `Edit ${data.name ?? 'venue'}`;
        if (saveLabel) saveLabel.textContent = 'Save changes';
        cancel?.classList.remove('is-hidden');
        form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      row.querySelector('[data-archive-venue]')?.addEventListener('click', async () => {
        if (!window.confirm(`Archive ${name}? It stays on past gigs but cannot be picked again.`)) {
          return;
        }
        const response = await fetch(`/api/admin/venues/${encodeURIComponent(id)}/archive`, {
          method: 'POST',
        });
        const data = (await response.json().catch(() => ({}))) as { ok?: boolean };
        if (response.ok && data.ok) window.location.reload();
        else say('That venue could not be archived.', 'error');
      });

      row.querySelector('[data-delete-venue]')?.addEventListener('click', async () => {
        if (!window.confirm(`Delete ${name}? Only a venue with no gigs can be deleted.`)) return;
        const response = await fetch(`/api/admin/venues/${encodeURIComponent(id)}`, {
          method: 'DELETE',
        });
        const data = (await response.json().catch(() => ({}))) as { ok?: boolean };
        if (response.ok && data.ok) window.location.reload();
        else
          say(
            'That venue could not be deleted. If it hosts gigs, archive it instead.',
            'error',
          );
      });
    });

    cancel?.addEventListener('click', () => {
      form?.reset();
      if (idInput) idInput.value = '';
      if (heading) heading.textContent = 'Add a venue';
      if (saveLabel) saveLabel.textContent = 'Save venue';
      cancel.classList.add('is-hidden');
      say('Edit cancelled.', 'ok');
    });
  }
</script>

<style>
  .venue-grid {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 23rem), 1fr));
  }

  .venue-item {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5);
    align-content: start;
  }

  .venue-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
  }

  .venue-cap {
    font-family: var(--font-display);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--volt);
  }

  .venue-address {
    font-style: normal;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .venue-notes {
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .venue-access {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-3);
    border-radius: var(--r-sm);
    background: rgb(255 255 255 / 3%);
    border: 1px solid var(--hairline);
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  .venue-usage {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .venue-upcoming {
    color: var(--go);
  }

  .venue-actions {
    display: flex;
    gap: var(--s-2);
  }

  .add-panel {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-5);
    scroll-margin-top: calc(var(--header-h) + var(--s-6));
  }

  .add-form {
    display: grid;
    gap: var(--s-4);
  }

  .add-grid {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 44rem) {
    .add-grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    }
  }

  .add-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px solid var(--hairline);
  }

  .venue-archived,
  .venue-archived-note {
    font-family: var(--font-display);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--warn);
  }

  .venue-archived {
    margin-left: var(--s-2);
  }

  .is-hidden {
    display: none;
  }

  .form-feedback {
    font-size: var(--step--2);
    font-weight: 600;
  }

  .form-feedback[data-tone='ok'] {
    color: var(--go);
  }

  .form-feedback[data-tone='error'] {
    color: var(--stop);
  }
</style>
