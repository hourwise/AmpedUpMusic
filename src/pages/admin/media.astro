---
/**
 * Photos and artwork.
 *
 * Organised by gig rather than as one undifferentiated library, because that
 * is how the work arrives: a photographer sends over the set from Saturday,
 * and it all belongs to Saturday.
 *
 * Alt text is presented as a required field with the image next to it, not as
 * an afterthought in a properties panel. An image without alt text should not
 * reach the website, and the interface should make that obvious rather than
 * enforcing it with an error at the last moment.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import Button from '@/components/ui/Button.astro';
import Field from '@/components/ui/Field.astro';
import Callout from '@/components/ui/Callout.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { getServices } from '@/services/index.ts';
import { SITE } from '@/lib/site.ts';

const services = getServices();
const gigs = await services.admin.listAll();

const sets = await Promise.all(
  gigs.map(async (gig) => ({ gig, assets: await services.media.listForEvent(gig.id) })),
);

const withAssets = sets.filter((set) => set.assets.length > 0).reverse();
const totalAssets = withAssets.reduce((sum, set) => sum + set.assets.length, 0);
const missingAlt = withAssets
  .flatMap((set) => set.assets)
  .filter((asset) => asset.alt.trim().length === 0).length;

const GIG_OPTIONS = [
  { value: '', label: 'Choose a gig...' },
  ...gigs.map((gig) => ({ value: gig.id, label: `${gig.title} - ${gig.shortDateLabel}` })),
];

const ROLE_OPTIONS = [
  { value: 'gallery', label: 'Gallery photograph' },
  { value: 'poster', label: 'Poster' },
  { value: 'hero', label: 'Hero photograph' },
  { value: 'artist', label: 'Artist image' },
];
---

<AdminLayout
  title="Photos"
  subtitle={`${totalAssets} images across ${withAssets.length} gigs. Galleries appear on the past gig pages and on the website gallery.`}
  wide
>
  <Button slot="actions" variant="volt" size="md" href="#upload">Add photos</Button>

  {
    missingAlt > 0 && (
      <Callout tone="warn" label="Needs attention" title={`${missingAlt} images have no description`}>
        <p>
          Images without a description cannot be read by anyone using a screen reader. Add one to
          each before the gig page goes live.
        </p>
      </Callout>
    )
  }

  <section class="upload-panel surface" id="upload" aria-labelledby="upload-heading">
    <h2 class="display display-sm" id="upload-heading">Add photos</h2>

    <form class="upload-form" data-media-form enctype="multipart/form-data">
      <div class="dropzone">
        <p class="dropzone-title">Choose a photograph</p>
        <p class="dropzone-hint">
          JPEG, PNG, WebP or AVIF, up to 8&nbsp;MB. The image is checked before it is stored.
        </p>
        <input
          type="file"
          name="file"
          data-media-file
          accept="image/jpeg,image/png,image/webp,image/avif"
          required
        />
      </div>

      <div class="upload-grid">
        <Field as="select" name="eventId" label="Which gig is it from" options={GIG_OPTIONS} />
        <Field as="select" name="role" label="What is it" required options={ROLE_OPTIONS} />
        <Field
          name="credit"
          label="Photographer"
          value={SITE.photographyPartner.name}
          hint="Credited under the gallery."
        />
      </div>

      <Field
        name="alt"
        label="Description"
        required
        hint="What is in the image, for anyone who cannot see it."
      />

      <div class="upload-actions">
        <Button type="submit" variant="volt" size="md" data-media-submit>Upload image</Button>
      </div>
      <p class="form-feedback" data-media-feedback role="status" aria-live="polite" hidden></p>
    </form>
  </section>

  <section class="upload-panel surface" id="gallery-upload" aria-labelledby="gallery-upload-heading">
    <h2 class="display display-sm" id="gallery-upload-heading">Add a gallery set</h2>
    <p class="add-intro">
      Choose several photographs for one gig. Each one needs its own description, and the order
      you pick them in is the order they appear on the site.
    </p>

    <form class="upload-form" data-gallery-form enctype="multipart/form-data">
      <div class="upload-grid">
        <Field as="select" name="galleryEventId" label="Which gig" required options={GIG_OPTIONS} />
        <Field
          name="galleryCredit"
          label="Photographer"
          value={SITE.photographyPartner.name}
          hint="Applied to the whole batch unless overridden per photograph."
        />
      </div>

      <input
        type="file"
        name="galleryFiles"
        data-gallery-files
        accept="image/jpeg,image/png,image/webp,image/avif"
        multiple
        required
      />
      <ul class="gallery-alt-list" data-gallery-alt-list></ul>

      <div class="upload-actions">
        <Button type="submit" variant="volt" size="md" data-gallery-submit>Upload gallery</Button>
      </div>
      <p class="form-feedback" data-gallery-feedback role="status" aria-live="polite" hidden></p>
    </form>

    <form class="upload-form" data-photography-form>
      <h3 class="add-artist-title">Photography details for a gig</h3>
      <div class="upload-grid">
        <Field as="select" name="photoEventId" label="Which gig" required options={GIG_OPTIONS} />
        <Field name="photoCredit" label="Credit line" hint="Shown under the gallery." />
        <Field name="photoGalleryUrl" label="Full gallery link" type="url" />
        <Field name="photoPhotographerUrl" label="Photographer link" type="url" />
      </div>
      <div class="upload-actions">
        <Button type="submit" variant="outline" size="md" data-photography-submit>
          Save photography details
        </Button>
      </div>
      <p class="form-feedback" data-photography-feedback role="status" aria-live="polite" hidden></p>
    </form>
  </section>

  {
    withAssets.length > 0 ? (
      withAssets.map((set) => (
        <section class="media-set" aria-labelledby={`set-${set.gig.id}`}>
          <header class="media-set-head">
            <div>
              <p class="eyebrow">{set.gig.shortDateLabel}</p>
              <h2 class="display display-sm" id={`set-${set.gig.id}`}>
                <a href={`/admin/gigs/${set.gig.id}`}>{set.gig.title}</a>
              </h2>
            </div>
            <p class="media-set-count">
              {set.assets.length} {set.assets.length === 1 ? 'image' : 'images'}
            </p>
          </header>

          <ul class="media-list" data-gallery-set={set.gig.id}>
            {set.assets.map((asset) => (
              <li class="media-item" data-gallery-item={asset.id} data-gallery-role={asset.role}>
                <img src={asset.url} alt={asset.alt} loading="lazy" decoding="async" />
                <div class="media-meta">
                  <p class="media-role">{asset.role}</p>
                  <label class="media-alt-label" for={`alt-${asset.id}`}>
                    Description
                  </label>
                  <textarea id={`alt-${asset.id}`} class="media-alt" rows={2}>{asset.alt}</textarea>
                  <div class="media-actions">
                    {asset.role === 'gallery' && (
                      <>
                        <Button
                          variant="ghost"
                          size="sm"
                          type="button"
                          data-gallery-move="-1"
                          aria-label={`Move ${asset.alt} earlier`}
                        >
                          Up
                        </Button>
                        <Button
                          variant="ghost"
                          size="sm"
                          type="button"
                          data-gallery-move="1"
                          aria-label={`Move ${asset.alt} later`}
                        >
                          Down
                        </Button>
                      </>
                    )}
                    <Button
                      variant="danger"
                      size="sm"
                      type="button"
                      data-delete-media
                      data-asset-id={asset.id}
                    >
                      Remove
                    </Button>
                  </div>
                </div>
              </li>
            ))}
          </ul>

          {set.gig.photography?.galleryUrl && (
            <p class="media-link">
              Linked to the full {set.gig.photography.credit} gallery:{' '}
              <a href={set.gig.photography.galleryUrl} rel="noopener">
                {set.gig.photography.galleryUrl}
              </a>
            </p>
          )}
        </section>
      ))
    ) : (
      <EmptyState
        title="No photographs yet"
        body="Add the set from a gig and it appears on the past gig page and in the website gallery automatically."
        actionHref="#upload"
        actionLabel="Add photos"
      />
    )
  }
</AdminLayout>

<script>
  // AMPED-05A: real protected upload and delete against the local R2 bucket.
  const form = document.querySelector<HTMLFormElement>('[data-media-form]');
  const feedback = document.querySelector<HTMLElement>('[data-media-feedback]');
  const submit = document.querySelector<HTMLButtonElement>('[data-media-submit]');

  const say = (message: string, tone: 'ok' | 'error') => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.dataset.tone = tone;
    feedback.hidden = false;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const file = form.querySelector<HTMLInputElement>('[data-media-file]')?.files?.[0];
    if (!file) {
      say('Choose an image first.', 'error');
      return;
    }

    const body = new FormData();
    body.append('file', file);
    body.append('role', (form.querySelector('[name="role"]') as HTMLSelectElement | null)?.value ?? '');
    body.append('alt', (form.querySelector('[name="alt"]') as HTMLInputElement | null)?.value.trim() ?? '');
    body.append('credit', (form.querySelector('[name="credit"]') as HTMLInputElement | null)?.value.trim() ?? '');
    body.append('eventId', (form.querySelector('[name="eventId"]') as HTMLSelectElement | null)?.value ?? '');

    if (submit) submit.disabled = true;
    try {
      const response = await fetch('/api/admin/media', { method: 'POST', body });
      const data = (await response.json().catch(() => ({}))) as {
        ok?: boolean;
        fields?: Record<string, string>;
      };
      if (!response.ok || !data.ok) {
        throw new Error(
          data.fields
            ? Object.values(data.fields).filter(Boolean).join(' ')
            : 'That image could not be uploaded.',
        );
      }
      window.location.reload();
    } catch (error) {
      if (submit) submit.disabled = false;
      say(error instanceof Error ? error.message : 'Upload failed.', 'error');
    }
  });

  document.querySelectorAll<HTMLElement>('[data-delete-media]').forEach((button) => {
    button.addEventListener('click', async () => {
      const id = button.dataset.assetId ?? '';
      if (!id || !window.confirm('Remove this image? This cannot be undone.')) return;
      const response = await fetch(`/api/admin/media/${encodeURIComponent(id)}`, { method: 'DELETE' });
      const data = (await response.json().catch(() => ({}))) as { ok?: boolean };
      if (response.ok && data.ok) window.location.reload();
      else say('That image could not be removed.', 'error');
    });
  });

  // --- AMPED-05B: gallery batch upload with per-file alt text --------------
  const galleryForm = document.querySelector<HTMLFormElement>('[data-gallery-form]');
  const galleryAltList = document.querySelector<HTMLElement>('[data-gallery-alt-list]');
  const galleryFeedback = document.querySelector<HTMLElement>('[data-gallery-feedback]');
  const gallerySubmit = document.querySelector<HTMLButtonElement>('[data-gallery-submit]');

  const gallerySay = (message: string, tone: 'ok' | 'error') => {
    if (!galleryFeedback) return;
    galleryFeedback.textContent = message;
    galleryFeedback.dataset.tone = tone;
    galleryFeedback.hidden = false;
  };

  galleryForm
    ?.querySelector('[data-gallery-files]')
    ?.addEventListener('change', (event) => {
      const files = Array.from((event.target as HTMLInputElement).files ?? []);
      if (!galleryAltList) return;
      galleryAltList.innerHTML = '';
      files.forEach((file, index) => {
        const item = document.createElement('li');
        item.className = 'gallery-alt-item';
        const name = document.createElement('p');
        name.textContent = `${index + 1}. ${file.name}`;
        const input = document.createElement('input');
        input.type = 'text';
        input.placeholder = 'Describe this photograph';
        input.dataset.galleryAlt = String(index);
        item.appendChild(name);
        item.appendChild(input);
        galleryAltList.appendChild(item);
      });
    });

  galleryForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const files = Array.from(
      galleryForm.querySelector<HTMLInputElement>('[data-gallery-files]')?.files ?? [],
    );
    const eventId = (galleryForm.querySelector('[name="galleryEventId"]') as HTMLSelectElement | null)?.value ?? '';
    const sharedCredit =
      (galleryForm.querySelector('[name="galleryCredit"]') as HTMLInputElement | null)?.value.trim() ?? '';
    if (!eventId || files.length === 0) {
      gallerySay('Choose a gig and at least one photograph.', 'error');
      return;
    }

    const manifest = files.map((_, index) => {
      const alt = (
        galleryForm.querySelector(`[data-gallery-alt="${index}"]`) as HTMLInputElement | null
      )?.value.trim() ?? '';
      return { alt, credit: sharedCredit };
    });
    const blank = manifest.findIndex((entry) => entry.alt.length === 0);
    if (blank >= 0) {
      gallerySay('Every photograph needs its own description.', 'error');
      return;
    }

    const body = new FormData();
    body.append('eventId', eventId);
    body.append('manifest', JSON.stringify(manifest));
    for (const file of files) body.append('files', file);

    if (gallerySubmit) gallerySubmit.disabled = true;
    try {
      const response = await fetch('/api/admin/media/gallery', { method: 'POST', body });
      const data = (await response.json().catch(() => ({}))) as {
        ok?: boolean;
        fields?: Record<string, string>;
      };
      if (!response.ok || !data.ok) {
        throw new Error(
          data.fields
            ? Object.values(data.fields).filter(Boolean).join(' ')
            : 'Those photographs could not be uploaded.',
        );
      }
      window.location.reload();
    } catch (error) {
      if (gallerySubmit) gallerySubmit.disabled = false;
      gallerySay(error instanceof Error ? error.message : 'Upload failed.', 'error');
    }
  });

  // --- AMPED-05B: reorder a gallery ----------------------------------------
  document.querySelectorAll<HTMLElement>('[data-gallery-set]').forEach((list) => {
    const eventId = list.dataset.gallerySet ?? '';
    list.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const move = target.closest<HTMLElement>('[data-gallery-move]');
      if (!move) return;
      const item = move.closest<HTMLElement>('[data-gallery-item]');
      if (!item) return;
      const direction = Number(move.dataset.galleryMove);
      if (direction < 0 && item.previousElementSibling) {
        list.insertBefore(item, item.previousElementSibling);
      } else if (direction > 0 && item.nextElementSibling) {
        list.insertBefore(item.nextElementSibling, item);
      }

      const assetIds = Array.from(
        list.querySelectorAll<HTMLElement>('[data-gallery-role="gallery"]'),
      ).map((row) => row.dataset.galleryItem ?? '');
      const response = await fetch('/api/admin/media/gallery/reorder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ eventId, assetIds }),
      });
      if (!response.ok) {
        gallerySay('That order could not be saved. Reload and try again.', 'error');
        return;
      }
      window.location.reload();
    });
  });

  // --- AMPED-05B: event photography metadata -------------------------------
  const photographyForm = document.querySelector<HTMLFormElement>('[data-photography-form]');
  const photographyFeedback = document.querySelector<HTMLElement>('[data-photography-feedback]');

  photographyForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const eventId = (photographyForm.querySelector('[name="photoEventId"]') as HTMLSelectElement | null)?.value ?? '';
    const payload = {
      eventId,
      credit: (photographyForm.querySelector('[name="photoCredit"]') as HTMLInputElement | null)?.value.trim() ?? '',
      galleryUrl: (photographyForm.querySelector('[name="photoGalleryUrl"]') as HTMLInputElement | null)?.value.trim() ?? '',
      photographerUrl: (photographyForm.querySelector('[name="photoPhotographerUrl"]') as HTMLInputElement | null)?.value.trim() ?? '',
    };
    try {
      const response = await fetch('/api/admin/media/photography', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await response.json().catch(() => ({}))) as {
        ok?: boolean;
        fields?: Record<string, string>;
      };
      if (!response.ok || !data.ok) {
        throw new Error(
          data.fields
            ? Object.values(data.fields).filter(Boolean).join(' ')
            : 'Those details could not be saved.',
        );
      }
      if (photographyFeedback) {
        photographyFeedback.textContent = 'Photography details saved.';
        photographyFeedback.dataset.tone = 'ok';
        photographyFeedback.hidden = false;
      }
    } catch (error) {
      if (photographyFeedback) {
        photographyFeedback.textContent =
          error instanceof Error ? error.message : 'Could not save those details.';
        photographyFeedback.dataset.tone = 'error';
        photographyFeedback.hidden = false;
      }
    }
  });
</script>

<style>
  .upload-panel {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-5);
    scroll-margin-top: calc(var(--header-h) + var(--s-6));
  }

  .upload-form {
    display: grid;
    gap: var(--s-4);
  }

  .upload-form input[type='file'] {
    color: var(--text-muted);
    font-size: var(--step--2);
  }

  .upload-actions {
    display: flex;
    justify-content: flex-end;
  }

  .gallery-alt-list {
    display: grid;
    gap: var(--s-2);
  }

  .gallery-alt-item {
    display: grid;
    gap: var(--s-1);
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  .gallery-alt-item input {
    padding: var(--s-2);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xs);
    background: var(--ink-inset);
    color: var(--text);
  }

  .form-feedback {
    font-size: var(--step--2);
    font-weight: 600;
  }

  .form-feedback[data-tone='ok'] {
    color: var(--go);
  }

  .form-feedback[data-tone='error'] {
    color: var(--stop);
  }

  .dropzone {
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    padding: var(--s-7) var(--s-4);
    border: 2px dashed var(--hairline-strong);
    border-radius: var(--r);
    text-align: center;
    background: rgb(255 255 255 / 2%);
  }

  .dropzone-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
  }

  .dropzone-hint {
    font-size: var(--step--2);
    color: var(--text-faint);
    max-width: 40ch;
  }

  .upload-grid {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 44rem) {
    .upload-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .media-set {
    display: grid;
    gap: var(--s-3);
  }

  .media-set-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--hairline);
  }

  .media-set-head a {
    text-decoration: none;
  }

  .media-set-head a:hover {
    color: var(--volt);
  }

  .media-set-count {
    font-family: var(--font-display);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .media-list {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .media-item {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-2);
    border: 1px solid var(--hairline);
    border-radius: var(--r);
    background: var(--ink-raised);
  }

  .media-item img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--r-sm);
    background: var(--ink-inset);
  }

  .media-meta {
    display: grid;
    gap: var(--s-1);
    padding: 0 var(--s-1) var(--s-1);
  }

  .media-role {
    font-family: var(--font-display);
    font-size: 0.62rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--volt);
  }

  .media-alt-label {
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .media-alt {
    width: 100%;
    padding: var(--s-2);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xs);
    background: var(--ink-inset);
    color: var(--text);
    font-size: var(--step--2);
    resize: vertical;
  }

  .media-alt:focus-visible {
    border-color: var(--volt);
  }

  .media-actions {
    display: flex;
    gap: var(--s-2);
    margin-top: var(--s-1);
  }

  .media-link {
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .media-link a {
    color: var(--volt);
  }
</style>
