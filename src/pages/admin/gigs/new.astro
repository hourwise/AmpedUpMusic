---
/** Create a new promotion. */
import AdminLayout from '@/layouts/AdminLayout.astro';
import PromotionForm from '@/components/admin/PromotionForm.astro';
import { getServices } from '@/services/index.ts';

const services = getServices();
const [venues, artists] = await Promise.all([services.venues.list(), services.artists.list()]);
---

<AdminLayout
  title="New promotion"
  subtitle="Four steps. Nothing goes on the website until you press Publish."
  back={{ label: 'All gigs', href: '/admin/gigs' }}
>
  <PromotionForm venues={venues} artists={artists} />
</AdminLayout>
