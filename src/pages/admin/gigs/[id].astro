---
/**
 * Edit an existing promotion.
 *
 * Same form as creating, plus the things that only exist once a gig is real:
 * a sales summary, Duplicate Promotion, and the lifecycle actions.
 *
 * Deletion behaviour follows the build plan exactly and is enforced in the UI
 * as well as (later) the API: a gig with orders against it can never be
 * deleted, only cancelled or archived. Drafts with nothing attached can be
 * deleted outright.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import PromotionForm from '@/components/admin/PromotionForm.astro';
import StatCard from '@/components/admin/StatCard.astro';
import StatusBadge from '@/components/admin/StatusBadge.astro';
import Button from '@/components/ui/Button.astro';
import Callout from '@/components/ui/Callout.astro';
import ConfirmDialog from '@/components/ui/ConfirmDialog.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { getServices } from '@/services/index.ts';
import { plural } from '@/lib/text.ts';

const { id } = Astro.params;
const services = getServices();
const event = id ? await services.admin.getById(id) : null;

if (!event) {
  Astro.response.status = 404;
}

const [venues, artists, summary] = event
  ? await Promise.all([
      services.venues.list(),
      services.artists.list(),
      services.admin.salesSummary(event.id),
    ])
  : [[], [], null];

const hasOrders = (summary?.sold ?? 0) > 0;
const canDelete = event?.status === 'draft' && !hasOrders;
---

{
  !event || !summary ? (
    <AdminLayout title="Gig not found" back={{ label: 'All gigs', href: '/admin/gigs' }}>
      <EmptyState
        title="That gig does not exist"
        body="It may have been deleted, or the link may be wrong."
        actionHref="/admin/gigs"
        actionLabel="Back to all gigs"
      />
    </AdminLayout>
  ) : (
    <AdminLayout
      title={event.title}
      subtitle={`${event.dateLabel} at ${event.venue.name}`}
      back={{ label: 'All gigs', href: '/admin/gigs' }}
    >
      <div slot="actions" class="head-actions">
        <StatusBadge kind="event" status={event.status} size="md" />
        <Button href={event.href} variant="ghost" size="md">View on site</Button>
        <Button variant="outline" size="md" type="button" data-duplicate-open>Duplicate</Button>
      </div>

      {event.status === 'draft' && (
        <Callout tone="warn" label="Draft" title="This gig is not on the website yet">
          <p>
            Nobody can see it and no tickets can be bought. Press Publish at the bottom of the page
            when you are ready.
          </p>
        </Callout>
      )}

      {(event.status === 'cancelled' || event.status === 'postponed') && (
        <Callout
          tone="stop"
          label={event.status === 'cancelled' ? 'Cancelled' : 'Postponed'}
          title="Customers are seeing a notice on the gig page"
        >
          <p>{event.statusMessage}</p>
        </Callout>
      )}

      <section class="summary" aria-label="How this gig is selling">
        <StatCard
          label="Sold"
          value={summary.sold}
          detail={`of ${summary.capacity} - ${summary.available} left`}
          percent={summary.percentSold}
          tone="volt"
        />
        <StatCard label="Taken" value={summary.grossLabel} detail="Before costs" tone="go" />
        <StatCard
          label="In checkout"
          value={summary.reserved}
          detail={summary.reserved > 0 ? 'Being paid for right now' : 'Nothing held'}
        />
        <StatCard label="Guest list" value={summary.guestList} detail="Comps and guests" />
      </section>

      <PromotionForm event={event} venues={venues} artists={artists} />

      <section
        class="danger"
        aria-labelledby="danger-heading"
        data-gig-admin
        data-event-id={event.id}
        data-event-status={event.status}
      >
        <h2 class="display display-sm" id="danger-heading">Changing or stopping this gig</h2>
        <p class="danger-intro">
          If something goes wrong with a date, use these rather than deleting anything. Ticket
          holders keep their tickets and we can email them all at once.
        </p>

        <div class="danger-grid">
          <div class="danger-card">
            <h3>Postpone</h3>
            <p>
              The gig page shows a postponed notice. Tickets stay valid. You can email everyone who
              has a ticket.
            </p>
            <Button variant="outline" size="md" data-confirm-open="postpone-confirm">
              Postpone this gig
            </Button>
          </div>

          <div class="danger-card">
            <h3>Cancel</h3>
            <p>
              Sales stop, the gig page shows a cancelled notice, and you can email everyone who has
              a ticket. Refunds are done in SumUp and then marked off here.
            </p>
            <Button variant="danger" size="md" data-confirm-open="cancel-confirm">
              Cancel this gig
            </Button>
          </div>

          <div class="danger-card">
            <h3>{canDelete ? 'Delete draft' : 'Delete'}</h3>
            <p>
              {canDelete
                ? 'This is a draft with no orders against it, so it can be deleted outright.'
                : `This gig has ${summary.sold} ${plural(summary.sold, 'ticket')} sold, so it can never be deleted. Cancel or archive it instead.`}
            </p>
            <Button variant="danger" size="md" inert={!canDelete} data-confirm-open="delete-confirm">
              Delete
            </Button>
          </div>
        </div>

        <p class="danger-feedback" data-gig-feedback role="status" aria-live="polite" hidden></p>
      </section>

      <dialog
        class="duplicate-dialog"
        id="duplicate-dialog"
        aria-labelledby="duplicate-title"
      >
        <div class="duplicate-panel">
          <h2 class="display display-sm" id="duplicate-title">Duplicate this promotion</h2>
          <p class="duplicate-body">
            Copies the venue, line-up, ticket types, prices, artwork and social links into a brand
            new draft. Orders, tickets and the old dates are not copied - set the new dates here.
          </p>
          <div class="duplicate-grid">
            <label class="duplicate-field">
              <span>New doors</span>
              <input type="datetime-local" name="newDoorsAt" data-duplicate-doors required />
            </label>
            <label class="duplicate-field">
              <span>New first act</span>
              <input type="datetime-local" name="newStartsAt" data-duplicate-starts required />
            </label>
          </div>
          <p class="duplicate-error" data-duplicate-error role="alert" hidden></p>
          <div class="duplicate-actions">
            <Button variant="ghost" size="md" type="button" data-duplicate-cancel>Cancel</Button>
            <Button variant="volt" size="md" type="button" data-duplicate-submit>Make a copy</Button>
          </div>
        </div>
      </dialog>

      <ConfirmDialog
        id="postpone-confirm"
        tone="volt"
        title="Postpone this gig?"
        body="The gig page will show a postponed notice and sales will stop. Tickets stay valid for the new date."
        consequence={
          summary.sold > 0
            ? `${summary.sold} ticket ${plural(summary.sold, 'holder')} will be offered an email.`
            : undefined
        }
        confirmLabel="Postpone"
        cancelLabel="Not yet"
      />

      <ConfirmDialog
        id="cancel-confirm"
        title="Cancel this gig?"
        body="Sales stop immediately and the gig page shows a cancellation notice. This cannot be undone from here."
        consequence={
          summary.sold > 0
            ? `${summary.sold} ${plural(summary.sold, 'ticket')} have been sold, worth ${summary.grossLabel}. Everyone will need refunding in SumUp.`
            : undefined
        }
        confirmLabel="Cancel the gig"
        cancelLabel="Keep it on"
      />

      <ConfirmDialog
        id="delete-confirm"
        title="Delete this draft?"
        body="The draft and everything in it will be removed. This cannot be undone."
        confirmLabel="Delete it"
        cancelLabel="Keep it"
      />
    </AdminLayout>
  )
}

<script>
  // AMPED-04B lifecycle actions: the buttons live in ConfirmDialog, whose own
  // handler closes the dialog; these listeners perform the real protected call.
  const root = document.querySelector<HTMLElement>('[data-gig-admin]');

  if (root) {
    const id = root.dataset.eventId ?? '';
    const status = root.dataset.eventStatus ?? '';
    const feedback = document.querySelector<HTMLElement>('[data-gig-feedback]');

    const say = (message: string, tone: 'ok' | 'error') => {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.dataset.tone = tone;
      feedback.hidden = false;
    };

    async function call(url: string, method: string, body?: unknown) {
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body),
      });
      const data = (await response.json().catch(() => ({}))) as {
        ok?: boolean;
        fields?: Record<string, string>;
      };
      if (!response.ok || !data.ok) {
        throw new Error(
          data.fields
            ? Object.values(data.fields).filter(Boolean).join(' ')
            : 'That action could not be completed.',
        );
      }
      return data;
    }

    function onAccept(dialogId: string, handler: () => Promise<void>) {
      document
        .querySelector(`#${dialogId} [data-confirm-accept]`)
        ?.addEventListener('click', () => {
          handler().catch((error: unknown) => {
            say(error instanceof Error ? error.message : 'That action failed.', 'error');
          });
        });
    }

    onAccept('postpone-confirm', async () => {
      const message = window.prompt(
        'Why is this gig postponed? This notice is shown to customers.',
        'New date to be announced.',
      );
      if (!message || !message.trim()) return;
      await call(`/api/admin/gigs/${encodeURIComponent(id)}/lifecycle`, 'POST', {
        to: 'postponed',
        from: status,
        statusMessage: message.trim(),
      });
      window.location.reload();
    });

    onAccept('cancel-confirm', async () => {
      const message = window.prompt(
        'Why is this gig cancelled? This notice is shown to customers.',
        'Cancelled - refunds will be issued.',
      );
      if (!message || !message.trim()) return;
      await call(`/api/admin/gigs/${encodeURIComponent(id)}/lifecycle`, 'POST', {
        to: 'cancelled',
        from: status,
        statusMessage: message.trim(),
      });
      window.location.reload();
    });

    onAccept('delete-confirm', async () => {
      await call(`/api/admin/gigs/${encodeURIComponent(id)}`, 'DELETE');
      window.location.assign('/admin/gigs');
    });

    // --- AMPED-04D: Duplicate Promotion requires the NEW dates -------------
    const duplicateDialog = document.querySelector<HTMLDialogElement>('#duplicate-dialog');
    const duplicateError = document.querySelector<HTMLElement>('[data-duplicate-error]');
    const duplicateDoors = duplicateDialog?.querySelector<HTMLInputElement>('[data-duplicate-doors]');
    const duplicateStarts = duplicateDialog?.querySelector<HTMLInputElement>('[data-duplicate-starts]');
    const duplicateSubmit = duplicateDialog?.querySelector<HTMLButtonElement>('[data-duplicate-submit]');

    const showDuplicateError = (message: string) => {
      if (!duplicateError) return;
      duplicateError.textContent = message;
      duplicateError.hidden = false;
    };

    document.querySelector('[data-duplicate-open]')?.addEventListener('click', () => {
      if (duplicateError) duplicateError.hidden = true;
      // Deliberately blank: the new dates are never pre-filled from the source.
      if (duplicateDoors) duplicateDoors.value = '';
      if (duplicateStarts) duplicateStarts.value = '';
      duplicateDialog?.showModal();
      duplicateDoors?.focus();
    });

    duplicateDialog?.querySelector('[data-duplicate-cancel]')?.addEventListener('click', () => {
      duplicateDialog.close();
    });

    duplicateDialog?.addEventListener('click', (event) => {
      if (event.target === duplicateDialog) duplicateDialog.close();
    });

    duplicateSubmit?.addEventListener('click', async () => {
      const doors = duplicateDoors?.value ?? '';
      const starts = duplicateStarts?.value ?? '';
      if (!doors || !starts) {
        showDuplicateError('Enter the new doors and first act times.');
        return;
      }

      duplicateSubmit.disabled = true;
      try {
        const data = (await call('/api/admin/gigs/duplicate', 'POST', {
          sourceEventId: id,
          newDoorsAt: doors,
          newStartsAt: starts,
        })) as { id?: string };
        if (!data.id) throw new Error('The copy could not be created.');
        window.location.assign(`/admin/gigs/${data.id}`);
      } catch (error) {
        duplicateSubmit.disabled = false;
        showDuplicateError(
          error instanceof Error ? error.message : 'That promotion could not be duplicated.',
        );
      }
    });
  }
</script>

<style>
  .danger-feedback {
    font-size: var(--step--2);
    font-weight: 600;
  }

  .danger-feedback[data-tone='error'] {
    color: var(--stop);
  }

  .head-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }

  .summary {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 52rem) {
    .summary {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .danger {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-5);
    border: 1px solid color-mix(in srgb, var(--stop) 30%, transparent);
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--stop) 4%, transparent);
  }

  .danger-intro {
    font-size: var(--step--1);
    color: var(--text-muted);
    max-width: 62ch;
  }

  .danger-grid {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 52rem) {
    .danger-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .danger-card {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-4);
    border: 1px solid var(--hairline);
    border-radius: var(--r);
    background: var(--ink-raised);
  }

  .danger-card h3 {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 800;
  }

  .danger-card p {
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  .danger-card :global(.btn) {
    justify-self: start;
  }

  .duplicate-dialog {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(34rem, calc(100vw - 2rem));
  }

  .duplicate-dialog::backdrop {
    background: rgb(4 4 6 / 80%);
    backdrop-filter: blur(4px);
  }

  .duplicate-panel {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-6);
    background: var(--ink-raised);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    color: var(--text);
  }

  .duplicate-body {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .duplicate-grid {
    display: grid;
    gap: var(--s-3);
  }

  @media (min-width: 34rem) {
    .duplicate-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .duplicate-field {
    display: grid;
    gap: var(--s-1);
    font-size: var(--step--2);
    font-weight: 600;
  }

  .duplicate-field input {
    padding: var(--s-2);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-sm);
    background: var(--ink);
    color: var(--text);
    font: inherit;
  }

  .duplicate-error {
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--stop);
  }

  .duplicate-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--s-3);
    margin-top: var(--s-2);
    flex-wrap: wrap;
  }
</style>
