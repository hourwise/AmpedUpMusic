---
/**
 * Door Mode chrome.
 *
 * Nothing in common with the rest of the admin on purpose. This is used
 * one-handed, on a phone, in a dark doorway, by someone who is also taking
 * money and talking to people. So:
 *
 *  - Full viewport height with no page scroll for the scanner itself.
 *  - No navigation rail, no breadcrumbs, no secondary links that could be
 *    tapped by accident and lose the scanner.
 *  - One way out, top left, clearly labelled.
 *  - The admission counter is always visible, because "how many are in" is
 *    the question door staff are asked all night.
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  /** Shown in the bar, e.g. "The Glass Hearts". */
  eventTitle?: string;
  exitHref?: string;
  exitLabel?: string;
}

const { title, eventTitle, exitHref = '/admin', exitLabel = 'Exit' } = Astro.props;
---

<BaseLayout
  title={`${title} - Door Mode`}
  description="Amped Up Door Mode."
  noindex
  bodyClass="door-body"
  lockViewport
>
  <div class="door">
    <header class="door-bar">
      <a class="door-exit" href={exitHref}>
        <span aria-hidden="true">&larr;</span>
        {exitLabel}
      </a>
      <p class="door-title">
        <span class="door-mode">Door</span>
        {eventTitle && <span class="door-event">{eventTitle}</span>}
      </p>
      <div class="door-meta">
        <slot name="meta" />
      </div>
    </header>

    <main class="door-main" id="main">
      <slot />
    </main>
  </div>
</BaseLayout>

<style is:global>
  /* Door Mode fills the screen and never scrolls the document itself. */
  body.door-body {
    overflow: hidden;
  }

  body.door-body .stage-wash,
  body.door-body::after {
    display: none;
  }
</style>

<style>
  .door {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100svh;
    background: var(--ink-void);
  }

  .door-bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: calc(var(--s-3) + env(safe-area-inset-top)) var(--s-4) var(--s-3);
    border-bottom: 1px solid var(--hairline);
    background: var(--ink-base);
  }

  .door-exit {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-pill);
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    flex: none;
  }

  .door-exit:hover {
    color: var(--volt);
    border-color: var(--volt);
  }

  .door-title {
    display: grid;
    min-width: 0;
    line-height: 1.2;
  }

  .door-mode {
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--stage-cyan);
  }

  .door-event {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step--1);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .door-meta {
    margin-left: auto;
    flex: none;
  }

  .door-main {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
</style>
